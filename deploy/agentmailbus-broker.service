# User unit. Run `loginctl enable-linger $USER` once so it starts at boot.
# Use token = "file:..." in the config; pass needs an unlocked gpg-agent.
[Unit]
Description=AgentMailBus broker

[Service]
ExecStart=%h/.local/share/agentmailbus/venv/bin/agentmailbus broker --config %h/.config/agentmailbus/broker.toml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
